{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "../../dist/scripts/migrations",
    "module": "commonjs",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "*": ["*", "../*", "../../src/*"]
    }
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
} 