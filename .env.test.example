# Environment
NODE_ENV=test

# MongoDB Configuration
# Use the same MONGODB_URI from the main .env file
# The database name will be replaced with gaiathon_test in the connection logic

# Redis Configuration
REDIS_URL=redis://redis:6379

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=test_secret_key_123
NEXTAUTH_JWT_SECRET=jwt_test_secret_key_123
NEXTAUTH_MAX_AGE=86400

# Admin Configuration
ADMIN_EMAIL=admin@gaiathon-hub.test
ADMIN_PASSWORD=admin_test_password_123
ADMIN_NAME=Test Admin

# Application Configuration
APP_NAME=GAIAthon Hub
APP_URL=http://localhost:3000

# Debug Configuration
DEBUG=true
JEST_TIMEOUT=30000

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379 