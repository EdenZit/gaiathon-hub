# GAIAthon Hub Environment Configuration
# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit .env files to version control
# Run scripts/generate-secrets.ts to generate secure values for secrets

# =========================================
# Application Configuration
# =========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================================
# Authentication Configuration
# =========================================
# NEXTAUTH_URL: Must match your deployment URL
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET: Run generate-secrets.ts to create this
NEXTAUTH_SECRET=your-nextauth-secret

# =========================================
# Database Configuration
# =========================================
# MongoDB Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?<options>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# MongoDB Connection Details
MONGODB_USER=your_mongodb_user
MONGODB_PASSWORD=your_secure_password
MONGODB_CLUSTER=your.cluster.mongodb.net
MONGODB_DATABASE=your_database_name
MONGODB_OPTIONS=retryWrites=true&w=majority&appName=YourAppName

# =========================================
# Redis Configuration
# =========================================
# Local Redis (Docker)
REDIS_URL=redis://localhost:6379
# Upstash Redis (Production)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# =========================================
# Security Configuration
# =========================================
# Generate these using scripts/generate-secrets.ts
JWT_SECRET=your-jwt-secret
SESSION_SECRET=your_generated_session_secret
CSRF_SECRET=your_generated_csrf_secret
ENCRYPTION_KEY=your_generated_encryption_key
COOKIE_SECRET=your_generated_cookie_secret

# =========================================
# Rate Limiting
# =========================================
# Requests per window per IP
RATE_LIMIT_MAX=100
# Window size in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=900000

# =========================================
# Admin Configuration
# =========================================
# Generate a secure password using scripts/generate-secrets.ts
ADMIN_PASSWORD=your_secure_admin_password

# =========================================
# Session Configuration
# =========================================
# Session duration in seconds
# 1800 = 30 minutes (recommended for security)
SESSION_MAX_AGE=1800
JWT_MAX_AGE=1800

# =========================================
# Security Features
# =========================================
# Enable built-in security features
ENABLE_RATE_LIMITING=true
ENABLE_CSRF_PROTECTION=true
# Enable maintenance mode (redirects all traffic to maintenance page)
MAINTENANCE_MODE=false

# =========================================
# Telemetry
# =========================================
# Disable Next.js telemetry for privacy
NEXT_TELEMETRY_DISABLED=1

# =========================================
# Development Tools
# =========================================
# Enable detailed error logging in development
DEBUG=false
# Test timeouts in milliseconds
JEST_TIMEOUT=30000

# =========================================
# Monitoring
# =========================================
# Prometheus multiprocess directory
PROMETHEUS_MULTIPROC_DIR=/tmp

# =========================================
# Docker
# =========================================
# Docker network name
DOCKER_NETWORK_NAME=gaiathon-network