    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.4.5",
    "ioredis": "^5.4.2",
    "jose": "^5.2.0",
    "lucide-react": "^0.471.2",
    "mongodb": "^6.12.0",
    "mongoose": "^8.10.1",
    "nanoid": "^5.0.9",
    "next": "^14.2.23",
    "next-auth": "^4.24.5",
    "nodemailer": "^6.10.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.1",
    "react-icons": "^4.12.0",
    "redis": "^4.6.12",
    "sonner": "^2.0.0",
    "swr": "^2.3.2",
