{
  "name": "gaiathon-hub",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json --noEmit",
    "task:run": "ts-node --project scripts/tsconfig.json scripts/runTasks.ts",
    "task:db": "ts-node --project scripts/tsconfig.json scripts/dockerTaskRunner.ts db",
    "task:api": "ts-node --project scripts/tsconfig.json scripts/dockerTaskRunner.ts api",
    "task:model": "ts-node --project scripts/tsconfig.json scripts/dockerTaskRunner.ts model",
    "docker:task": "ts-node scripts/dockerTaskRunner.ts",
    "composer:auth": "ts-node scripts/composer/index.ts typescript-fixes.auth",
    "composer:dashboard": "ts-node scripts/composer/index.ts typescript-fixes.dashboard",
    "composer:api": "ts-node scripts/composer/index.ts typescript-fixes.api",
    "composer:pages": "ts-node scripts/composer/index.ts typescript-fixes.pages",
    "composer:all": "ts-node scripts/composer/index.ts typescript-fixes",
    "agent": "ts-node scripts/composer/agent.ts",
    "agent:auth": "ts-node scripts/composer/agent.ts auth",
    "agent:dashboard": "ts-node scripts/composer/agent.ts dashboard",
    "agent:api": "ts-node scripts/composer/agent.ts api",
    "agent:pages": "ts-node scripts/composer/agent.ts pages",
    "agent:all": "ts-node scripts/composer/agent.ts all",
    "db:clean": "ts-node --project scripts/tsconfig.json scripts/cleanDatabase.ts",
    "project:reorganize": "ts-node --project scripts/tsconfig.json scripts/reorganizeProject.ts",
    "test:data": "TS_NODE_PROJECT=scripts/tests/tsconfig.json ts-node scripts/tests/testDataLayer.ts",
    "check:db": "TS_NODE_PROJECT=scripts/tests/tsconfig.json ts-node scripts/tests/checkMongoConnection.ts",
    "generate-secrets": "ts-node scripts/generate-secrets.ts"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.0.18",
    "@react-email/components": "^0.0.32",
    "@react-email/render": "^1.0.4",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.4",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
