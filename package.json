    "@types/react-dom": "^18",
    "@types/yaml": "^1.9.6",
    "autoprefixer": "^10.4.17",
    "chalk": "^5.4.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "yaml": "^2.7.0"
  }
