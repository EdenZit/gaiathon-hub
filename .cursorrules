{
  "project_context": {
    "name": "GAIAthon-Hub",
    "description": "A unified platform for Earth Observation resources, collaboration, and innovation.",
    "goal": "To create a collaborative environment where users can access Earth Observation tools, share resources, and work together on projects with AI assistance."
  },

  "development_rules": [
    {
      "description": "Infrastructure Requirements (DO NOT REMOVE)",
      "rules": [
        "ALWAYS use Docker Compose for local development",
        "MongoDB Atlas is used for database - DO NOT switch to local MongoDB",
        "Redis is required and runs in Docker",
        "All services must be configured to work with Docker networking",
        "Environment variables must be compatible with both Docker and MongoDB Atlas"
      ]
    },
    {
      "description": "Authentication Flow",
      "rules": [
        "All protected routes must redirect to /register for unauthenticated users",
        "User registration requires only email, password, and full name initially",
        "Profile completion with additional details can be done after registration",
        "Password hashing is handled by User model pre-save hook",
        "Session must include firstName for personalized welcome messages"
      ]
    },
    {
      "description": "Navigation & UI",
      "rules": [
        "Dropdowns should close when cursor leaves the dropdown area (150ms delay)",
        "Protected links in navbar and footer must use handleProtectedLink",
        "All links should open in the same window unless explicitly required otherwise",
        "Maintain consistent navy theme across UI elements",
        "Tools and features should only be accessible through Navbar and Footer when authenticated",
        "Team workspace features should be organized under /resources/team-workspace"
      ]
    },
    {
      "description": "Error Handling",
      "rules": [
        "Provide specific error messages for validation failures",
        "Handle MongoDB duplicate key errors gracefully",
        "Format validation errors with field names and messages",
        "Log errors with appropriate detail level"
      ]
    },
    {
      "description": "Code Organization",
      "rules": [
        "Place new components in appropriate directories under src/components",
        "Maintain strict TypeScript typing",
        "Use NextAuth.js for authentication",
        "Keep API routes organized under src/app/api",
        "Platform-specific tools should be organized under resources/tools",
        "Team collaboration features should be organized under resources/team-workspace"
      ]
    }
  ],

  "project_status": {
    "completed_features": [
      "User authentication and registration",
      "Profile management with extended fields",
      "Team creation and management",
      "Team member invitation system",
      "Basic team workspace structure",
      "Database cleaning utility script"
    ],
    "in_progress_features": [
      "Real-time team chat using Socket.IO",
      "Document management with collaborative editing",
      "Project timeline with calendar integration",
      "Progress tracking system",
      "Team activity feed"
    ],
    "pending_features": [
      "Google Drive integration for documents",
      "Real-time cursor position tracking",
      "Message threading in team chat",
      "Event export/import functionality",
      "Performance analytics dashboard",
      "Team milestone management"
    ]
  },

  "commit_guidelines": {
    "format": "<type>(<scope>): <description>",
    "types": [
      "feat: New feature",
      "fix: Bug fix",
      "refactor: Code change that neither fixes a bug nor adds a feature",
      "style: Changes that do not affect the meaning of the code",
      "docs: Documentation only changes"
    ],
    "scopes": [
      "auth",
      "ui",
      "api",
      "db",
      "nav",
      "gallery",
      "tools",
      "workspace"
    ]
  }
}